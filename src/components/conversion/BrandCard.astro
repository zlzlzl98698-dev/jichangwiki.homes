---
export interface BrandProps {
  id: string;
  slug: string;
  name: string;
  aliases?: string[];
  isPrimary?: boolean;
  establishedYear: number;
  logo: string;
  entryPrice: string;
  minMonthlyPrice?: number;
  protocols: string[];
  networkTypes: string[];
  couponCodes?: Array<{ code: string; discount: string }>;
  strengths: string[];
  affiliateURL: string;
}

export interface Props {
  brand: BrandProps;
}

const { brand } = Astro.props;
const topCoupon = brand.couponCodes && brand.couponCodes[0] && brand.couponCodes[0].code !== '待核实' ? brand.couponCodes[0].code : null;
---

<div class={`rounded-2xl border transition-all duration-300 p-5 bg-white flex flex-col justify-between hover:shadow-lg ${brand.isPrimary ? 'border-blue-500 ring-2 ring-blue-500/20 shadow-md' : 'border-slate-200'}`}>
  <div>
    <!-- Top badge & header -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-3">
        <img 
          src={brand.logo} 
          alt={`${brand.name} Logo`}
          class="w-12 h-12 rounded-xl object-contain bg-slate-50 border border-slate-100 p-1"
          loading="lazy"
          onerror="this.src='/images/logos/xdm_logo.webp'"
        />
        <div>
          <div class="flex items-center gap-1.5">
            <h3 class="font-extrabold text-slate-900 text-base leading-tight">
              <a href={`/brands/${brand.slug}/`} class="hover:text-blue-600 transition">
                {brand.name}
              </a>
            </h3>
            {brand.isPrimary && (
              <span class="px-1.5 py-0.5 rounded bg-blue-100 text-blue-700 text-[10px] font-bold">
                主推
              </span>
            )}
          </div>
          <div class="text-[11px] text-slate-500 mt-0.5">
            {brand.establishedYear} 年起运营 · {brand.networkTypes[0] || '专线中转'}
          </div>
        </div>
      </div>

      <div class="text-right">
        <span class="text-xs font-mono font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-md border border-emerald-100 block">
          {brand.entryPrice}
        </span>
      </div>
    </div>

    <!-- Tags & Badges -->
    <div class="flex flex-wrap gap-1.5 mb-3">
      {brand.protocols.slice(0, 2).map(p => (
        <span class="text-[10px] px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-mono">
          {p}
        </span>
      ))}
      {topCoupon && (
        <button
          type="button"
          class="text-[10px] px-2 py-0.5 rounded bg-amber-50 hover:bg-amber-100 text-amber-800 font-mono font-semibold border border-amber-200 cursor-pointer inline-flex items-center gap-1 transition copy-coupon-btn active:scale-95"
          data-copy={topCoupon}
          title={`点击复制优惠码 ${topCoupon}`}
        >
          <span>券: {topCoupon}</span>
          <svg class="w-2.5 h-2.5 text-amber-600 inline-block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </button>
      )}
    </div>

    <!-- Highlight Bullets -->
    <ul class="text-xs text-slate-600 space-y-1.5 mb-4 line-clamp-3">
      {brand.strengths.slice(0, 2).map(s => (
        <li class="flex items-start gap-1.5">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>{s}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Actions -->
  <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <a 
        href={`/brands/${brand.slug}/`} 
        class="text-xs font-medium text-slate-600 hover:text-blue-600 hover:underline"
      >
        实体详情
      </a>
      <span class="text-slate-300">·</span>
      <a 
        href={`/reviews/${brand.slug}/`} 
        class="text-xs font-medium text-blue-600 hover:underline"
      >
        深度评测
      </a>
    </div>

    <a 
      href={brand.affiliateURL}
      target="_blank"
      rel="nofollow sponsored noopener noreferrer"
      class="px-3 py-1.5 rounded-lg bg-blue-600 text-white text-xs font-semibold hover:bg-blue-700 transition"
    >
      官网注册
    </a>
  </div>
</div>
