---
// src/components/conversion/MobileStickyCTA.astro
import brands from '../../data/brands.json';

export interface Props {
  brand?: any;
}

const { brand } = Astro.props;
const guangsu = brand || brands.find(b => b.id === 'guangsu') || brands[0];
const topCoupon = guangsu.couponCodes && guangsu.couponCodes[0] && guangsu.couponCodes[0].code !== '待核实' 
  ? guangsu.couponCodes[0].code 
  : 'AMM';
---

<!-- Mobile Sticky Bottom Conversion Bar -->
<aside 
  class="sm:hidden fixed bottom-0 left-0 right-0 z-50 bg-slate-900/95 backdrop-blur-md border-t border-slate-700/80 px-3.5 py-2.5 shadow-2xl flex items-center justify-between gap-2.5 transition-all duration-300"
  aria-label="优惠与直达快速导航"
>
  <div class="flex items-center gap-2.5 min-w-0">
    <img 
      src={guangsu.logo || '/images/logos/guangsu.webp'} 
      alt="光速云 Logo" 
      class="w-9 h-9 rounded-xl object-contain bg-slate-800 p-0.5 border border-slate-700 shrink-0 shadow-sm" 
      onerror="this.src='/images/logos/xdm_logo.webp'"
      loading="lazy"
    />
    <div class="min-w-0">
      <div class="flex items-center gap-1.5">
        <span class="text-xs font-extrabold text-white truncate">{guangsu.name} IEPL 专线</span>
        <span class="text-[10px] px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-300 font-mono font-bold shrink-0 border border-emerald-500/30">
          8.25元起
        </span>
      </div>
      <div class="flex items-center gap-1 text-[11px] text-slate-300 mt-0.5">
        <span class="text-slate-400">9折券:</span>
        <button 
          type="button" 
          class="font-mono font-bold text-amber-300 bg-amber-400/10 hover:bg-amber-400/20 px-1.5 py-0.2 rounded border border-amber-300/30 cursor-pointer copy-coupon-btn inline-flex items-center gap-1 transition" 
          data-copy={topCoupon} 
          title={`点击复制优惠码 ${topCoupon}`}
        >
          <span>{topCoupon}</span>
          <svg class="w-3 h-3 text-amber-300 inline-block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <a 
    href={guangsu.affiliateURL}
    target="_blank"
    rel="nofollow sponsored noopener noreferrer"
    class="px-4 py-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-xs font-bold shadow-md hover:from-blue-500 hover:to-indigo-500 transition shrink-0 flex items-center gap-1 active:scale-95 border border-blue-400/30"
  >
    <span>直达官网</span>
    <span>&rarr;</span>
  </a>
</aside>
