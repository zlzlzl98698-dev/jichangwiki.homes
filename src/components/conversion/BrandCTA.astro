---
export interface Props {
  brand?: any;
  brandName?: string;
  affiliateURL?: string;
  couponCode?: string;
  entryPrice?: string;
  variant?: 'inline' | 'card' | 'banner';
  customTitle?: string;
  customDesc?: string;
}

const {
  brand,
  brandName: rawName,
  affiliateURL: rawAffiliate,
  couponCode: rawCoupon,
  entryPrice: rawPrice,
  variant = 'card',
  customTitle,
  customDesc
} = Astro.props;

const brandName = rawName || brand?.name || '光速云';
const affiliateURL = rawAffiliate || brand?.affiliateURL || 'https://jichangwiki.homes';
const couponCode = rawCoupon || brand?.couponCode;
const entryPrice = rawPrice || brand?.entryPrice || (brand?.startingPrice ? `¥${brand.startingPrice}/月` : undefined);
---

{variant === 'inline' && (
  <div class="my-4 p-3.5 bg-blue-50/80 rounded-xl border border-blue-200/80 flex flex-wrap items-center justify-between gap-3 text-xs sm:text-sm">
    <div class="flex items-center gap-2">
      <span class="text-blue-600 font-bold">🚀 推荐入口:</span>
      <span class="text-slate-800 font-semibold">{brandName}</span>
      {couponCode && couponCode !== '待核实' && (
        <button 
          type="button" 
          class="px-2 py-0.5 rounded bg-amber-100 hover:bg-amber-200 text-amber-800 text-[11px] font-mono font-medium cursor-pointer inline-flex items-center gap-1 transition copy-coupon-btn active:scale-95"
          data-copy={couponCode}
          title={`点击复制优惠码 ${couponCode}`}
        >
          <span>券码: {couponCode}</span>
          <svg class="w-2.5 h-2.5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </button>
      )}
    </div>
    <div class="flex items-center gap-3">
      {entryPrice && <span class="text-slate-600 text-xs font-mono">{entryPrice}</span>}
      <a 
        href={affiliateURL}
        target="_blank"
        rel="nofollow sponsored noopener noreferrer"
        class="inline-flex items-center justify-center px-4 py-1.5 rounded-lg bg-blue-600 text-white font-medium text-xs hover:bg-blue-700 shadow-sm transition"
      >
        前往官网注册 &rarr;
      </a>
    </div>
  </div>
)}

{variant === 'card' && (
  <div class="my-6 p-5 sm:p-6 bg-gradient-to-br from-slate-900 to-slate-800 rounded-2xl text-white shadow-xl border border-slate-700/80 relative overflow-hidden">
    <!-- Subtle top right glow -->
    <div class="absolute -right-10 -top-10 w-40 h-40 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <span class="px-2 py-0.5 rounded bg-blue-500/20 text-blue-300 text-[11px] font-semibold border border-blue-500/30">
            官方优选通道
          </span>
          {couponCode && couponCode !== '待核实' && (
            <button 
              type="button" 
              class="px-2 py-0.5 rounded bg-amber-400/20 hover:bg-amber-400/30 text-amber-300 text-[11px] font-mono font-bold border border-amber-400/30 cursor-pointer inline-flex items-center gap-1 transition copy-coupon-btn active:scale-95"
              data-copy={couponCode}
              title={`点击复制优惠码 ${couponCode}`}
            >
              <span>优惠码: {couponCode}</span>
              <svg class="w-2.5 h-2.5 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </button>
          )}
        </div>
        <h4 class="text-lg sm:text-xl font-extrabold text-white tracking-tight">
          {customTitle || `立即选购 ${brandName}`}
        </h4>
        <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-xl leading-relaxed">
          {customDesc || `支持专线传输、全平台客户端导入与高品质 AI/流媒体体验，低成本试水，安全稳定。`}
        </p>
      </div>

      <div class="flex flex-col sm:items-end gap-2 flex-shrink-0">
        {entryPrice && (
          <div class="text-sm font-mono text-emerald-400 font-bold">
            资费参考: {entryPrice}
          </div>
        )}
        <a 
          href={affiliateURL}
          target="_blank"
          rel="nofollow sponsored noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-2.5 rounded-xl bg-blue-600 text-white font-bold text-sm hover:bg-blue-500 shadow-lg shadow-blue-600/30 transition transform hover:-translate-y-0.5"
        >
          前往 {brandName} 注册 &rarr;
        </a>
      </div>
    </div>

    <!-- Compliance footer note -->
    <div class="mt-4 pt-3 border-t border-slate-800 text-[11px] text-slate-400 flex items-center justify-between">
      <span>* 推广链接包含推荐参数，本站可能获得佣金，不增加用户实付成本。</span>
      <span class="text-slate-300">安全直达 · 官方正品</span>
    </div>
  </div>
)}

{variant === 'banner' && (
  <div class="my-8 p-6 sm:p-8 bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 rounded-3xl text-white shadow-2xl border border-blue-700/50 relative overflow-hidden">
    <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-blue-200 text-xs font-semibold border border-blue-400/30">
          <span>🏆 全站第一主推品牌</span>
          <span>·</span>
          <span>2020年起持续运营</span>
        </div>
        <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
          光速云 (Guangsu Cloud) 深度综合优选
        </h3>
        <p class="text-sm text-slate-300 max-w-2xl leading-relaxed">
          IEPL 专线 + 企业级内网专线双架构，VLESS 高速协议，年付轻量折算仅约 ¥8/月。同时提供自研客户端与 Clash / Shadowrocket 订阅导入，特设 247GB 不过期永久套餐。
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-1 text-xs">
          <span class="px-2.5 py-1 rounded-md bg-white/10 text-slate-200">新人特惠码: <strong class="text-amber-300 font-mono">AMM</strong></span>
          <span class="px-2.5 py-1 rounded-md bg-white/10 text-slate-200">致敬斯诺克永久版: ¥147</span>
          <span class="px-2.5 py-1 rounded-md bg-white/10 text-slate-200">轻量版: ¥99/年 (69G/月)</span>
        </div>
      </div>

      <div class="flex flex-col items-center gap-3 w-full md:w-auto">
        <a 
          href={affiliateURL}
          target="_blank"
          rel="nofollow sponsored noopener noreferrer"
          class="w-full md:w-auto text-center px-8 py-3.5 rounded-xl bg-blue-500 text-white font-extrabold text-base hover:bg-blue-400 shadow-xl shadow-blue-500/40 transition transform hover:-translate-y-0.5"
        >
          立即前往光速云官网 &rarr;
        </a>
        <a 
          href="/reviews/guangsu/"
          class="text-xs text-blue-300 hover:text-white underline transition"
        >
          查看光速云万字深度评测报告
        </a>
      </div>
    </div>
  </div>
)}
