---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 transition-all">
  <div class="max-w-[1600px] mx-auto px-2 sm:px-4 lg:px-6 2xl:px-8">
    <div class="flex items-center justify-between h-16 gap-1 lg:gap-2">
      
      <!-- Brand Logo & Name -->
      <div class="flex items-center gap-2 2xl:gap-3 flex-shrink-0">
        <a href="/" class="flex items-center gap-2 group">
          <img 
            src="/images/avatar.webp" 
            alt="百科机场 Logo" 
            class="w-8 h-8 2xl:w-9 2xl:h-9 rounded-lg object-cover shadow-sm ring-1 ring-slate-200 group-hover:ring-blue-500 transition flex-shrink-0"
            width="36"
            height="36"
          />
          <div class="flex flex-col">
            <span class="font-extrabold text-slate-900 text-base 2xl:text-lg leading-tight group-hover:text-blue-600 transition tracking-tight whitespace-nowrap">百科机场</span>
            <span class="text-[9px] 2xl:text-[10px] text-slate-500 font-medium tracking-wide whitespace-nowrap">JICHANGWIKI.HOMES</span>
          </div>
        </a>
      </div>

      <!-- Desktop Mega Navigation (10 Categories) -->
      <nav class="hidden xl:flex items-center space-x-0.5 2xl:space-x-1 flex-shrink-0">
        {navItems.map((item, idx) => (
          <div class="relative group flex-shrink-0">
            <a 
              href={item.url} 
              class="px-1.5 2xl:px-2.5 py-1.5 text-xs 2xl:text-[13px] font-medium text-slate-700 hover:text-blue-600 rounded-md hover:bg-slate-50 transition-colors inline-flex items-center gap-0.5 2xl:gap-1 whitespace-nowrap flex-shrink-0"
            >
              <span class="whitespace-nowrap select-none">{item.name}</span>
              <svg class="w-2.5 h-2.5 text-slate-400 group-hover:text-blue-600 transition-transform group-hover:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            
            <!-- Dropdown Menu -->
            <div class={`absolute top-full hidden group-hover:block w-64 pt-2 z-50 ${idx >= 7 ? 'right-0' : 'left-0'}`}>
              <div class="bg-white rounded-xl shadow-xl border border-slate-100 p-2 overflow-hidden ring-1 ring-black/5 animate-in fade-in-50 duration-200">
                <div class="px-3 py-1.5 border-b border-slate-100 mb-1">
                  <a href={item.url} class="text-xs font-semibold text-blue-600 hover:underline flex items-center justify-between">
                    <span>{item.name} 专题主页</span>
                    <span>&rarr;</span>
                  </a>
                </div>
                {item.children.map((sub) => (
                  <a 
                    href={sub.url} 
                    class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition group/sub"
                  >
                    <div class="text-[13px] font-medium text-slate-800 group-hover/sub:text-blue-600">
                      {sub.name}
                    </div>
                    <div class="text-[11px] text-slate-500 line-clamp-1">
                      {sub.desc}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </nav>

      <!-- Right Search & CTA Action -->
      <div class="flex items-center gap-1.5 2xl:gap-3 flex-shrink-0">
        <a 
          href="/search/" 
          class="p-1.5 2xl:p-2 text-slate-500 hover:text-blue-600 hover:bg-slate-100 rounded-lg transition"
          aria-label="站内智能搜索"
        >
          <svg class="w-4 h-4 2xl:w-5 2xl:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>

        <a 
          href="/brands/guangsu/" 
          class="hidden sm:inline-flex items-center justify-center px-2.5 2xl:px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700 shadow-sm transition whitespace-nowrap flex-shrink-0"
        >
          主推·光速云
        </a>

        <!-- Mobile Drawer Button -->
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="xl:hidden p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none"
          aria-label="打开菜单"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden xl:hidden border-t border-slate-200 bg-white max-h-[80vh] overflow-y-auto px-4 py-4 space-y-3">
    <div class="mb-2">
      <a href="/search/" class="flex items-center gap-2 w-full px-3 py-2 bg-slate-100 text-slate-600 rounded-lg text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>搜索机场、协议、客户端或故障...</span>
      </a>
    </div>
    {navItems.map((item) => (
      <div class="border-b border-slate-100 pb-2">
        <div class="flex items-center justify-between py-1">
          <a href={item.url} class="font-bold text-slate-900 text-sm">{item.name}</a>
          <a href={item.url} class="text-xs text-blue-600">专题主页</a>
        </div>
        <div class="grid grid-cols-2 gap-1.5 mt-1">
          {item.children.map((sub) => (
            <a href={sub.url} class="px-2 py-1 text-xs text-slate-600 hover:text-blue-600 bg-slate-50 hover:bg-blue-50 rounded">
              {sub.name}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
