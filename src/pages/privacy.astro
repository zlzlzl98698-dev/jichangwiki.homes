---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "隐私政策与法律免责声明 - 百科机场";
const description = "百科机场 (jichangwiki.homes) 的隐私政策、无用户日志承诺、知识产权与法律免责声明。我们恪守严格的数据最小化与零隐私收集原则。";
const canonical = "https://jichangwiki.homes/privacy/";

const breadcrumbs = [
  { name: "首页", url: "/" },
  { name: "隐私与免责", url: "/privacy/" }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": canonical,
      "url": canonical,
      "name": title,
      "description": description,
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "首页", "item": "https://jichangwiki.homes/" },
          { "@type": "ListItem", "position": 2, "name": "隐私与免责", "item": canonical }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "百科机场会记录我的访问 IP 或浏览历史吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "绝对不会。百科机场是一个基于纯静态页面构建（Static Site Generation）的技术知识库，没有后端用户数据库，不架设任何用户注册系统，不收集、不存储、亦不出售任何访客的 IP 地址或浏览足迹。"
          }
        },
        {
          "@type": "Question",
          "name": "本站是否使用第三方追踪 Cookie？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "本站不部署任何侵入式的第三方广告追踪 Cookie 或跨站画像分析脚本。本地存储仅用于保存用户的主题外观或搜索过滤等基础偏好设置。"
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Top Header -->
    <header class="mb-10 border-b border-slate-200 pb-8">
      <div class="flex items-center gap-2 text-xs font-semibold text-blue-600 mb-2">
        <span>合规文件 · 隐私防线与法律条款</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        隐私政策与法律免责声明 (Privacy Policy & Terms)
      </h1>
      <p class="text-slate-600 text-sm sm:text-base mt-4 leading-relaxed max-w-4xl">
        生效日期：2026 年 1 月 1 日 · 最后更新：2026 年 11 月 23 日。<br/>
        百科机场 (jichangwiki.homes) 严格尊重并保护每一位读者的数字隐私权。本页面向您透明告知我们的数据最小化准则、免责界限与内容许可规则。
      </p>
    </header>

    <div class="lg:grid lg:grid-cols-12 lg:gap-8 items-start">
      
      <!-- Main Content Column -->
      <div class="lg:col-span-8 min-w-0 space-y-12">
        
        <!-- Answer-First Summary -->
        <section class="bg-blue-50/70 rounded-2xl p-6 sm:p-8 border border-blue-200/80 shadow-sm">
          <div class="flex items-center gap-2.5 text-blue-900 font-bold text-sm mb-2">
            <span class="text-lg">🛡️</span>
            核心隐私承诺速览 (Zero-Log Principle)
          </div>
          <p class="text-slate-700 text-sm leading-relaxed">
            <strong>百科机场作为纯静态技术知识库，践行国际通行的“零日志（Zero-Log）”与“数据最小化（Data Minimization）”准则。</strong> 我们不要求任何读者注册账号，不记录访客的 IP 与访问偏好，不部署任何跨站点广告追踪网络。您的所有访问均以完全匿名的方式在本地浏览器端完成。
          </p>
        </section>

        <!-- Section 1: Data Collection & Privacy -->
        <section class="space-y-4">
          <h2 class="text-2xl font-bold text-slate-900 border-b border-slate-200 pb-2">
            一、 数据收集与隐私保护政策
          </h2>
          <div class="space-y-3 text-sm text-slate-700 leading-relaxed">
            <p>
              <strong>1. 个人身份信息：</strong> 本站不提供用户注册、登录、评论发帖或付费充值功能，因此我们不会以任何形式收集您的姓名、电话号码、邮箱地址或身份证件信息。
            </p>
            <p>
              <strong>2. 服务器基础访问日志：</strong> 本站静态文件由全球分布式内容分发网络（CDN）进行边缘缓存分发。CDN 服务商仅会在网络协议层面对突发流量、网络攻击（如 DDoS）进行瞬时防御性过滤，相关连接元数据在内存中即时处理，不进行长期持久化存储。
            </p>
            <p>
              <strong>3. 本地存储 (LocalStorage)：</strong> 本站可能会在您的浏览器本地写入少量的本地键值（如您在搜索框的历史关键词过滤或暗黑模式偏好），此类数据仅存放在您个人的设备终端，绝不会上传至任何远程服务器。
            </p>
          </div>
        </section>

        <!-- Section 2: External Links & Commercial Disclaimers -->
        <section class="space-y-4">
          <h2 class="text-2xl font-bold text-slate-900 border-b border-slate-200 pb-2">
            二、 第三方服务商与外部链接免责声明
          </h2>
          <div class="space-y-3 text-sm text-slate-700 leading-relaxed">
            <p>
              <strong>1. 外部独立主体：</strong> 本站包含通向各大代理服务商官网、GitHub 开源客户端仓库及技术文档的外部超链接。这些被链接的外部网站属于独立的第三方实体，其经营行为、服务质量、数据隐私政策与财务状况完全独立于百科机场。
            </p>
            <p>
              <strong>2. 交易行为独立性：</strong> 当您点击外部链接离开本站并在第三方服务商平台进行账号注册、套餐充值或订购时，您与该第三方服务商直接构成民事合同关系。本站不经手任何用户资金，亦不承担因第三方服务商网络故障、节点被封锁、政策变更或运营主体跑路所产生的任何直接或间接财产损失。
            </p>
            <p>
              <strong>3. 决策风险自负：</strong> 本站提供的排行榜、测速数据、架构解析与选型建议仅供技术交流与学术参考。网络环境受宽带运营商、物理路由与地理位置影响极大，读者在下单前应充分知晓风险，建议优先选择“首月月付”进行实地验证。
            </p>
          </div>
        </section>

        <!-- Section 3: Legal Use & Compliance -->
        <section class="space-y-4">
          <h2 class="text-2xl font-bold text-slate-900 border-b border-slate-200 pb-2">
            三、 合规守法与技术研究声明
          </h2>
          <div class="space-y-3 text-sm text-slate-700 leading-relaxed">
            <p>
              百科机场致力于普及计算机网络通信原理、跨国网络拓扑（IEPL/IPLC）、密码学端到端加密机制及主流开源代理客户端（如 Clash、sing-box、Shadowrocket）的标准使用方法。
            </p>
            <p>
              所有读者必须严格遵守当地法律法规。严禁将本站介绍的技术工具与网络节点用于任何危害国家网络安全、侵犯他人知识产权、从事网络诈骗、洗钱或传播非法信息的活动。因违反相关法律法规而产生的一切法律后果，均由使用者本人独立承担。
            </p>
          </div>
        </section>

        <!-- Section 4: Copyright & Licensing -->
        <section class="space-y-4">
          <h2 class="text-2xl font-bold text-slate-900 border-b border-slate-200 pb-2">
            四、 原创内容版权与引用授权
          </h2>
          <div class="space-y-3 text-sm text-slate-700 leading-relaxed">
            <p>
              除明确标注来源于公共开源协议的图表与技术规范外，百科机场 (jichangwiki.homes) 的所有原创长文、深度评测体系、决策架构图及实测数据表格均受知识产权法律保护。
            </p>
            <p>
              任何个人或商业机构若需引用本站内容，必须保留完整上下文，并显式标注出处链接：<code>https://jichangwiki.homes/</code>。严禁未经授权通过爬虫程序进行批量采集、洗稿或用于商业倒卖。
            </p>
          </div>
        </section>

        <!-- FAQ Accordion -->
        <section class="space-y-3 pt-4">
          <h2 class="text-xl font-bold text-slate-900 mb-2">隐私政策常见疑问</h2>
          <div class="space-y-3">
            <details class="group bg-white rounded-xl border border-slate-200 p-4 open:bg-slate-50 transition">
              <summary class="font-bold text-slate-800 text-sm cursor-pointer list-none flex justify-between items-center">
                <span>百科机场会记录我的访问 IP 或浏览历史吗？</span>
                <span class="text-slate-400 group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs text-slate-600 mt-3 leading-relaxed">
                绝对不会。百科机场是一个基于纯静态页面构建（Static Site Generation）的技术知识库，没有后端用户数据库，不架设任何用户注册系统，不收集、不存储、亦不出售任何访客的 IP 地址或浏览足迹。
              </p>
            </details>
            <details class="group bg-white rounded-xl border border-slate-200 p-4 open:bg-slate-50 transition">
              <summary class="font-bold text-slate-800 text-sm cursor-pointer list-none flex justify-between items-center">
                <span>本站是否使用第三方追踪 Cookie？</span>
                <span class="text-slate-400 group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs text-slate-600 mt-3 leading-relaxed">
                本站不部署任何侵入式的第三方广告追踪 Cookie 或跨站画像分析脚本。本地存储仅用于保存用户的主题外观或搜索过滤等基础偏好设置。
              </p>
            </details>
          </div>
        </section>

      </div>

      <!-- Right Column: Sidebar -->
      <aside class="hidden lg:block lg:col-span-4 space-y-6">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm sticky top-20">
          <h3 class="text-sm font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span>⚖️</span> 法律与信任规范
          </h3>
          <ul class="space-y-3 text-xs text-slate-600">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>数据最小化原则 (Data Minimization)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>无日志承诺 (Zero-Log Policy)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>透明推广披露 (Affiliate Disclosure)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>免责条款与风险提示常态化公示</span>
            </li>
          </ul>

          <div class="mt-6 pt-5 border-t border-slate-100 space-y-2">
            <a href="/about/" class="block text-xs text-blue-600 hover:underline">
              &rarr; 了解《关于我们与评测标准》
            </a>
            <a href="/risk/security/" class="block text-xs text-blue-600 hover:underline">
              &rarr; 阅读《数字隐私与零信任安全指南》
            </a>
            <a href="/risk/avoid-scams/" class="block text-xs text-blue-600 hover:underline">
              &rarr; 查阅《新手防坑与跑路预警》
            </a>
          </div>
        </div>
      </aside>

    </div>
  </div>
</BaseLayout>
