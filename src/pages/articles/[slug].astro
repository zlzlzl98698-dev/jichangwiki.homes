---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandCard from '../../components/conversion/BrandCard.astro';
import BrandCTA from '../../components/conversion/BrandCTA.astro';
import MobileStickyCTA from '../../components/conversion/MobileStickyCTA.astro';
import AffiliateDisclosure from '../../components/conversion/AffiliateDisclosure.astro';
import articles from '../../data/articles.json';
import brands from '../../data/brands.json';

export async function getStaticPaths() {
  return articles.map(art => ({
    params: { slug: art.slug },
    props: { article: art }
  }));
}

const { article } = Astro.props;
const guangsu = brands.find(b => b.id === 'guangsu') || brands[0];

const title = `${article.title} | 百科机场`;
const description = article.description;
const canonical = `https://jichangwiki.homes/articles/${article.slug}/`;

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: article.parentHubName, url: article.parentHubUrl },
  { name: article.title, url: canonical }
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': canonical,
      'headline': article.title,
      'description': article.description,
      'url': canonical,
      'datePublished': article.date,
      'dateModified': article.updated,
      'author': {
        '@type': 'Organization',
        'name': article.author,
        'url': 'https://jichangwiki.homes/'
      },
      'publisher': {
        '@type': 'Organization',
        'name': '百科机场',
        'logo': {
          '@type': 'ImageObject',
          'url': 'https://jichangwiki.homes/favicon.svg'
        }
      }
    },
    {
      '@type': 'FAQPage',
      'mainEntity': article.faqs.map(f => ({
        '@type': 'Question',
        'name': f.q,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': f.a
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center text-sm text-slate-500 mb-6 space-x-2">
      <a href="/" class="hover:text-primary-600 transition-colors">首页</a>
      <span>/</span>
      <a href={article.parentHubUrl} class="hover:text-primary-600 transition-colors">{article.parentHubName}</a>
      <span>/</span>
      <span class="text-slate-800 font-medium truncate max-w-xs">{article.title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10 pb-8 border-b border-slate-200">
      <div class="flex items-center space-x-2 text-xs text-blue-600 font-semibold mb-3">
        <a href={article.parentHubUrl} class="px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors">
          {article.parentHubName}
        </a>
        <span>·</span>
        <time datetime={article.updated}>更新时间：{article.updated}</time>
        <span>·</span>
        <span class="inline-flex items-center gap-1.5">
          <img src="/images/avatar.webp" alt={article.author} class="w-4 h-4 rounded-full object-cover ring-1 ring-blue-200 inline-block" />
          <span>作者：{article.author}</span>
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        {article.title}
      </h1>

      <p class="text-base text-slate-600 leading-relaxed mb-6">
        {article.description}
      </p>

      <!-- Answer-First Box -->
      <div class="bg-blue-50/80 border border-blue-200 rounded-2xl p-6">
        <div class="flex items-center space-x-2 text-blue-900 font-bold mb-2">
          <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>核心速查结论 (Answer-First)</span>
        </div>
        <p class="text-sm text-blue-950 leading-relaxed font-sans">
          {article.verdict}
        </p>
      </div>
    </header>

    <!-- Main Content Sections -->
    <article class="prose prose-slate max-w-none mb-12">
      {article.sections.map(sec => (
        <section class="mb-10">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span class="w-1.5 h-6 bg-blue-600 rounded-full inline-block"></span>
            {sec.heading}
          </h2>
          <div class="text-slate-700 text-sm sm:text-base leading-relaxed space-y-4 font-sans" set:html={sec.content} />
        </section>
      ))}
    </article>

    <!-- Related High-Reliability Brand Recommendation -->
    <section class="mb-12 bg-slate-50 p-6 rounded-3xl border border-slate-200">
      <h3 class="text-lg font-bold text-slate-900 mb-2">💡 推荐搭配的高可靠专线服务商</h3>
      <p class="text-xs text-slate-600 mb-4 leading-relaxed">
        本文涉及的高清流媒体 4K 播放、AI 账号防封与低延迟电竞加速，需配合具备真实物理 IEPL/IPLC 专线的服务商体验更佳：
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <BrandCard brand={guangsu} />
        <div class="flex flex-col justify-between p-4 bg-white rounded-2xl border border-slate-200 text-xs">
          <div>
            <span class="text-blue-600 font-bold block mb-1">专线直达保障</span>
            <p class="text-slate-600 leading-relaxed mb-3">
              光速云具备端到端真实物理专线，支持一键导入主流客户端，提供 OpenAI/Claude 专属纯净出口，晚高峰不卡顿。
            </p>
          </div>
          <BrandCTA brand={guangsu} />
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-slate-900 mb-4">相关常见疑问 (FAQ)</h2>
      <div class="space-y-4">
        {article.faqs.map(faq => (
          <details class="group bg-white rounded-xl border border-slate-200 p-5 open:bg-slate-50 transition-colors">
            <summary class="font-semibold text-slate-900 cursor-pointer flex justify-between items-center list-none text-sm">
              <span>{faq.q}</span>
              <span class="text-blue-600 group-open:rotate-180 transition-transform duration-200">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed text-xs sm:text-sm pt-2 border-t border-slate-100">{faq.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Navigation Breadcrumbs -->
    <nav class="bg-slate-50 rounded-2xl p-6 border border-slate-200 mb-10 text-xs sm:text-sm">
      <h4 class="font-bold text-slate-900 mb-2">文章归属与相关专题</h4>
      <div class="flex flex-wrap gap-3">
        <a href={article.parentHubUrl} class="text-blue-600 hover:underline">返回上级：{article.parentHubName}</a>
        <a href="/articles/" class="text-blue-600 hover:underline">全部技术文章索引</a>
        <a href="/compare/" class="text-blue-600 hover:underline">机场品牌横向对比</a>
        <a href="/brands/reviews/" class="text-blue-600 hover:underline">全部品牌独立评测</a>
      </div>
    </nav>

    <AffiliateDisclosure />
  </div>

  <!-- Mobile Sticky Conversion Bar -->
  <MobileStickyCTA />
</BaseLayout>
