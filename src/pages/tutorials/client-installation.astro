---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandCard from '../../components/conversion/BrandCard.astro';
import BrandCTA from '../../components/conversion/BrandCTA.astro';
import MobileStickyCTA from '../../components/conversion/MobileStickyCTA.astro';
import AffiliateDisclosure from '../../components/conversion/AffiliateDisclosure.astro';
import brands from '../../data/brands.json';

const title = "客户端安装指引：Windows、Mac、iOS、Android 零基础正版安装与避坑完全指南";
const description = "全面解决各平台代理客户端的下载、安装、签名信任与防钓鱼安全指引。针对小白用户提供清晰、规范、官方正版的安装路径。";
const breadcrumbs = [{"name":"首页","url":"/"},{"name":"使用教程","url":"/tutorials/"},{"name":"client-installation","url":"/tutorials/client-installation/"}];
const jsonLd = {"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://jichangwiki.homes/tutorials/client-installation/","url":"https://jichangwiki.homes/tutorials/client-installation/","name":"客户端安装指引：Windows、Mac、iOS、Android 零基础正版安装与避坑完全指南","description":"全面解决各平台代理客户端的下载、安装、签名信任与防钓鱼安全指引。针对小白用户提供清晰、规范、官方正版的安装路径。","breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"首页","item":"https://jichangwiki.homes/"},{"@type":"ListItem","position":2,"name":"使用教程","item":"https://jichangwiki.homes/tutorials/"},{"@type":"ListItem","position":3,"name":"客户端安装指引：Windows、Mac、iOS、Android 零基础正版安装与避坑完全指南","item":"https://jichangwiki.homes/tutorials/client-installation/"}]}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"为什么网上下载的 Clash 会被火绒或 360 拦截报毒？","acceptedAnswer":{"@type":"Answer","text":"由于代理软件的核心行为包含“修改 Windows 系统网络代理”和“安装 Wintun 虚拟网卡驱动”，这与某些恶意木马劫持网络流量的行为在启发式分析中特征高度重合。只要您确认是从官方 GitHub 仓库下载的源码发布版，属于标准的误报行为，直接在杀软中添加信任即可。"}},{"@type":"Question","name":"iOS 小火箭在国区 App Store 搜不到，淘宝买现成 Apple ID 安全吗？","acceptedAnswer":{"@type":"Answer","text":"淘宝购买的共享 Apple ID 存在极高风险，很多账号会被恶意锁定并开启“查找我的 iPhone”进行敲诈。最安全稳妥的方法是自己在苹果官网花费 3 分钟免费注册一个属于自己的专属美区账号，全程无需绑定境外信用卡。"}},{"@type":"Question","name":"Mac 电脑是 M 系列芯片（M1/M2/M3），应该下载哪个版本的安装包？","acceptedAnswer":{"@type":"Answer","text":"在 GitHub Releases 下载页面中，文件名带有 `aarch64` 或 `arm64` 的是专门针对苹果 Apple Silicon（M 系列）芯片编译的原生架构版本；带有 `x64` 的则是老款 Intel 芯片版本。下载原生 arm64 版本运行效率最高、耗电最低。"}},{"@type":"Question","name":"老版 Clash for Windows（CFW）还能继续用吗？为什么推荐换 Verge？","acceptedAnswer":{"@type":"Answer","text":"CFW 开发者早在 2023 年底已停止维护并删库，其内置的 Clash 内核不再支持诸如 Reality、Hysteria2、AnyTLS 等最新的现代抗封锁协议，且旧版 Electron 存在潜在安全漏洞。全面迁移到活跃维护的 Clash Verge Rev 是目前整个行业的主流共识。"}},{"@type":"Question","name":"光速云后台提供的客户端下载安全吗？","acceptedAnswer":{"@type":"Answer","text":"完全安全。光速云后台用户中心收录的客户端均为官方 GitHub Releases 的原版分流镜像，未经任何二次篡改或反编译，方便国内无法直连 GitHub 的用户一键极速下载正版软件。"}}]}]};

const guangsu = brands.find(b => b.id === 'guangsu') || brands[0];
const displayBrands = brands.slice(0, 6);
const faqs = [{"q":"为什么网上下载的 Clash 会被火绒或 360 拦截报毒？","a":"由于代理软件的核心行为包含“修改 Windows 系统网络代理”和“安装 Wintun 虚拟网卡驱动”，这与某些恶意木马劫持网络流量的行为在启发式分析中特征高度重合。只要您确认是从官方 GitHub 仓库下载的源码发布版，属于标准的误报行为，直接在杀软中添加信任即可。"},{"q":"iOS 小火箭在国区 App Store 搜不到，淘宝买现成 Apple ID 安全吗？","a":"淘宝购买的共享 Apple ID 存在极高风险，很多账号会被恶意锁定并开启“查找我的 iPhone”进行敲诈。最安全稳妥的方法是自己在苹果官网花费 3 分钟免费注册一个属于自己的专属美区账号，全程无需绑定境外信用卡。"},{"q":"Mac 电脑是 M 系列芯片（M1/M2/M3），应该下载哪个版本的安装包？","a":"在 GitHub Releases 下载页面中，文件名带有 `aarch64` 或 `arm64` 的是专门针对苹果 Apple Silicon（M 系列）芯片编译的原生架构版本；带有 `x64` 的则是老款 Intel 芯片版本。下载原生 arm64 版本运行效率最高、耗电最低。"},{"q":"老版 Clash for Windows（CFW）还能继续用吗？为什么推荐换 Verge？","a":"CFW 开发者早在 2023 年底已停止维护并删库，其内置的 Clash 内核不再支持诸如 Reality、Hysteria2、AnyTLS 等最新的现代抗封锁协议，且旧版 Electron 存在潜在安全漏洞。全面迁移到活跃维护的 Clash Verge Rev 是目前整个行业的主流共识。"},{"q":"光速云后台提供的客户端下载安全吗？","a":"完全安全。光速云后台用户中心收录的客户端均为官方 GitHub Releases 的原版分流镜像，未经任何二次篡改或反编译，方便国内无法直连 GitHub 的用户一键极速下载正版软件。"}];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Top Hub Header -->
    <header class="mb-8 border-b border-slate-200 pb-6">
      <div class="flex items-center gap-2 text-xs font-semibold text-blue-600 mb-2">
        <span>全平台正版安装 · 远离假冒木马</span>
        <span>·</span>
        <span>上级主题: <a href="/tutorials/" class="underline hover:text-blue-800">使用教程总览</a></span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        客户端安装指引：全平台零基础正版安全安装指南
      </h1>
      <p class="text-slate-600 text-sm sm:text-base mt-3 leading-relaxed max-w-4xl">
        在搜索引擎下载到了携带木马的假冒客户端？本文为您整理四大主流平台最权威、最干净的官方正版下载渠道、安全校验与安装避雷指南。
      </p>
    </header>

    <!-- Main Two-Column Grid on Desktop -->
    <div class="lg:grid lg:grid-cols-12 lg:gap-8 items-start">
      
      <!-- Left Column: Main Long-Form Encyclopedic Content -->
      <div class="lg:col-span-9 min-w-0">
        
        <!-- Answer-First Executive Summary Box -->
        <section id="verdict" class="scroll-mt-24 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl border border-blue-200 p-6 sm:p-8 mb-12 shadow-sm">
          <div class="flex items-center gap-2 text-blue-950 font-extrabold text-lg mb-3">
            <span class="text-xl">💡</span>
            <span>安装安全核心警示 (Verdict)</span>
          </div>
          <div class="text-sm sm:text-base text-blue-950 leading-relaxed space-y-3 font-sans">
            <p><strong>严禁在百度、360 等国内搜索引擎前排竞价广告中下载任何代理客户端安装包</strong>！这些广告包几乎全部被黑产团队捆绑了剪贴板劫持木马（专门监控并替换虚拟货币钱包地址）或挖矿程序。请务必通过<strong>官方 GitHub 开源仓库 Releases 页面</strong>或<strong>正规应用商店（美区 App Store / Google Play）</strong>下载经过 SHA256 校验的官方正版安装包。</p>
          </div>
        </section>

        <!-- Section 1: Deep Industry / Technical Analysis -->
        <section id="section-1" class="scroll-mt-24 mb-14">
          <h2 class="text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span class="w-1.5 h-6 bg-blue-600 rounded-full inline-block"></span>
            一、 代理客户端开源生态与官方可信发行通道全景
          </h2>
          <div class="text-slate-700 text-sm sm:text-base leading-relaxed space-y-4">
            <p>随着科学上网技术的成熟，代理客户端软件已全面演进为高度透明的开源项目。正规的客户端其源代码完全在 GitHub 上公开受全球数万开发者审查，具有极高的透明度和安全性。了解各大平台的旗舰开源项目与正确的发行通道至关重要：</p>
<div class="p-5 bg-slate-900 text-slate-200 rounded-2xl font-mono text-xs my-4 space-y-2 border border-slate-800">
  <div class="text-emerald-400 font-bold mb-2">【全平台官方正规发行通道导航】</div>
  <div>■ Windows / macOS / Linux 桌面平台：</div>
  <div>  - 核心旗舰：Clash Verge Rev (认准 GitHub: clash-verge-rev/clash-verge-rev)</div>
  <div>  - 特性：基于 Rust + Tauri 开发，内存占用仅 30MB，原生搭载最新 Mihomo 内核</div>
  <div>■ iOS / iPadOS 苹果移动平台：</div>
  <div>  - 唯一首选：Shadowrocket (俗称小火箭，认准美区/港区 App Store 正版，开发者 Shadow Launch Technology)</div>
  <div>  - 旗舰备选：Quantumult X / Loon / Stash</div>
  <div>■ Android 安卓平台：</div>
  <div>  - 简洁实用：v2rayNG (认准 GitHub: 2dust/v2rayNG)</div>
  <div>  - 跨平台现代 UI：FlClash (认准 GitHub: chen08209/FlClash)</div>
</div>
<p>在 GitHub 下载时，务必认准 <strong>Latest Release</strong> 标签，并核对仓库的 Star 数量（通常知名客户端 Star 数在数千到数万以上）。切勿下载任何陌生个人网盘、Telegram 闲聊群内转发的经过未知二次打包的 <code>.exe</code> 或 <code>.apk</code> 安装文件。</p>
          </div>
        </section>

        <!-- Section 2: Core Architecture & Traps -->
        <section id="section-2" class="scroll-mt-24 mb-14">
          <h2 class="text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span class="w-1.5 h-6 bg-indigo-600 rounded-full inline-block"></span>
            二、 操作系统安全防护与数字签名拦截排错实操
          </h2>
          <div class="text-slate-700 text-sm sm:text-base leading-relaxed space-y-4">
            <p>由于代理软件的核心功能涉及网络底层流量重定向、虚拟网卡驱动安装与系统代理修改，各大操作系统的内置安全机制常常会弹出警告拦截。以下是官方正版软件在各平台的正常放行流程：</p>
<ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm text-slate-700 my-3">
  <li><strong>Windows SmartScreen 拦截提示“未知发布者”：</strong> 由于开源软件未向微软购买昂贵的企业 EV 代码签名证书，Windows Defender 会弹出蓝底警告窗。点击左侧的“更多信息 (More info)”，下方会出现“仍要运行 (Run anyway)”按钮，点击即可正常安装；</li>
  <li><strong>macOS 提示“已损坏，无法打开”或“开发者无法验证”：</strong> 苹果 macOS Gatekeeper 安全机制对未公证应用默认拦截。解决方法：打开“终端 (Terminal)”，输入 <code>sudo xattr -r -d com.apple.quarantine /Applications/Clash Verge Rev.app</code> 并回车输入开机密码，即可彻底解除隔离标志；</li>
  <li><strong>iOS 获取美区 App Store 账号技巧：</strong> 苹果国区应用商店早已将所有代理软件下架。用户只需在浏览器注册一个免信用卡绑定的美区 Apple ID，并在 App Store 退出当前账号后登录美区 ID，购买礼品卡充值后即可正规下载正版 Shadowrocket；</li>
  <li><strong>Android 报毒“包含高风险代码”：</strong> 部分国产深度定制系统（如华为鸿蒙、小米澎湃）会对翻墙类软件进行弹窗告警。只要确认 APK 来源于官方 GitHub Releases，选择“继续安装并允许所有网络权限”即可。</li>
</ul>
          </div>
        </section>

        <!-- Section 3: Head-to-Head Specification / Comparison Table -->
        <section id="comparison-table" class="scroll-mt-24 mb-14">
          <h2 class="text-2xl font-bold text-slate-900 mb-2 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span class="w-1.5 h-6 bg-emerald-600 rounded-full inline-block"></span>
            全平台客户端安装包规格与系统环境要求一览表
          </h2>
      <p class="text-xs sm:text-sm text-slate-600 mb-4">
        主流客户端技术规格与运行环境对照：
      </p>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm mb-6">
        <table class="w-full text-xs sm:text-sm text-left border-collapse">
          <thead class="bg-slate-100 text-slate-800 font-bold border-b border-slate-200">
            <tr>
              <th class="py-3 px-4">平台</th><th class="py-3 px-4">推荐软件</th><th class="py-3 px-4">内核引擎</th><th class="py-3 px-4">官方安装包格式</th><th class="py-3 px-4">最低系统版本</th><th class="py-3 px-4">系统架构支持</th><th class="py-3 px-4">安全校验方式</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">Windows</td><td class="py-3 px-4 ">Clash Verge Rev</td><td class="py-3 px-4 ">Mihomo (Clash.Meta)</td><td class="py-3 px-4 ">.exe 安装包 / 免安装 .zip</td><td class="py-3 px-4 ">Windows 10 / 11 64位</td><td class="py-3 px-4 ">x64 / ARM64</td><td class="py-3 px-4 ">SHA256 散列值核对</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">macOS</td><td class="py-3 px-4 ">Clash Verge Rev</td><td class="py-3 px-4 ">Mihomo (Clash.Meta)</td><td class="py-3 px-4 ">.dmg 镜像文件</td><td class="py-3 px-4 ">macOS 11.0 Big Sur 以上</td><td class="py-3 px-4 ">Intel x64 / Apple M系列</td><td class="py-3 px-4 ">去除隔离签名 (xattr)</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">iOS</td><td class="py-3 px-4 ">Shadowrocket</td><td class="py-3 px-4 ">自研多协议引擎</td><td class="py-3 px-4 ">App Store 官方分发</td><td class="py-3 px-4 ">iOS 14.0 或更高版本</td><td class="py-3 px-4 ">ARM64</td><td class="py-3 px-4 ">苹果官方商店沙盒验证</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">Android</td><td class="py-3 px-4 ">v2rayNG</td><td class="py-3 px-4 ">Xray-core</td><td class="py-3 px-4 ">.apk 安装包</td><td class="py-3 px-4 ">Android 8.0 以上</td><td class="py-3 px-4 ">armeabi-v7a / arm64-v8a</td><td class="py-3 px-4 ">APK 官方开发者证书验证</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">Android</td><td class="py-3 px-4 ">FlClash</td><td class="py-3 px-4 ">Mihomo (Clash.Meta)</td><td class="py-3 px-4 ">.apk 安装包</td><td class="py-3 px-4 ">Android 7.0 以上</td><td class="py-3 px-4 ">全架构适配</td><td class="py-3 px-4 ">GitHub Release 签名</td>
              </tr>
            
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 4: Brand Showcase Grid -->
    <section id="recommended-brands" class="scroll-mt-24 mb-14">
      <h2 class="text-2xl font-bold text-slate-900 mb-6 pb-2 border-b border-slate-100">
        为各平台提供清晰安装指南与官方正版链接的专线品牌
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {displayBrands.map(b => (
          <BrandCard brand={b} />
        ))}
      </div>
    </section>

    <!-- Section 5: Buyer Decision Tree & Best Practices -->
    <section id="decision-tree" class="scroll-mt-24 mb-14">
      <h2 class="text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-amber-500 rounded-full inline-block"></span>
        设备环境与客户端匹配决策树
      </h2>
      <div class="text-slate-700 text-sm sm:text-base leading-relaxed space-y-4">
        <div class="bg-amber-50/70 border border-amber-200 rounded-2xl p-5 space-y-3 my-4">
          
            <div class="flex items-start gap-3">
              <span class="font-bold text-amber-900 bg-amber-200/80 px-2 py-0.5 rounded text-xs flex-shrink-0">Windows 办公本</span>
              <p class="text-xs sm:text-sm text-slate-800 leading-relaxed">
                <strong>日常办公追求省电低占用与简洁界面：</strong> 毫不犹豫首选 Clash Verge Rev，基于 Tauri 架构打造，内存占用仅为老旧 Electron 客户端的十分之一。
              </p>
            </div>
          
            <div class="flex items-start gap-3">
              <span class="font-bold text-amber-900 bg-amber-200/80 px-2 py-0.5 rounded text-xs flex-shrink-0">新购苹果全家桶</span>
              <p class="text-xs sm:text-sm text-slate-800 leading-relaxed">
                <strong>iPhone + Mac 联动跨国协同：</strong> 手机端用 Shadowrocket，Mac 电脑安装 Clash Verge Rev，两端导入同一个光速云订阅，操作逻辑高度契合苹果生态。
              </p>
            </div>
          
            <div class="flex items-start gap-3">
              <span class="font-bold text-amber-900 bg-amber-200/80 px-2 py-0.5 rounded text-xs flex-shrink-0">极客与多协议测试</span>
              <p class="text-xs sm:text-sm text-slate-800 leading-relaxed">
                <strong>需要测试 Sing-box、Hysteria2 等全新黑科技：</strong> 可尝试 Sing-box 跨平台客户端，支持原生的最新协议解析，适合动手能力强的进阶玩家。
              </p>
            </div>
          
        </div>

