---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandCard from '../../components/conversion/BrandCard.astro';
import BrandCTA from '../../components/conversion/BrandCTA.astro';
import MobileStickyCTA from '../../components/conversion/MobileStickyCTA.astro';
import AffiliateDisclosure from '../../components/conversion/AffiliateDisclosure.astro';
import brands from '../../data/brands.json';

const title = "分流规则设置指南：国内直连与海外代理的智能网络分流实战";
const description = "全面解决科学上网时‘微信掉线、淘宝定位错乱、百度变慢’的痛点。详解 DOMAIN-SUFFIX、GEOIP、IP-CIDR 分流语法与广告过滤规则集配置。";
const breadcrumbs = [{"name":"首页","url":"/"},{"name":"使用教程","url":"/tutorials/"},{"name":"routing-rules","url":"/tutorials/routing-rules/"}];
const jsonLd = {"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://jichangwiki.homes/tutorials/routing-rules/","url":"https://jichangwiki.homes/tutorials/routing-rules/","name":"分流规则设置指南：国内直连与海外代理的智能网络分流实战","description":"全面解决科学上网时‘微信掉线、淘宝定位错乱、百度变慢’的痛点。详解 DOMAIN-SUFFIX、GEOIP、IP-CIDR 分流语法与广告过滤规则集配置。","breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"首页","item":"https://jichangwiki.homes/"},{"@type":"ListItem","position":2,"name":"使用教程","item":"https://jichangwiki.homes/tutorials/"},{"@type":"ListItem","position":3,"name":"分流规则设置指南：国内直连与海外代理的智能网络分流实战","item":"https://jichangwiki.homes/tutorials/routing-rules/"}]}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"为什么访问国内网站（如百度、淘宝）突然变慢或验证码频出？","acceptedAnswer":{"@type":"Answer","text":"这 99% 是因为客户端误开成了“全局代理 (Global)”模式，导致所有本应直连的国内流量绕道海外机房再折返，延迟飙升且国内电商平台会将海外 IP 标记为可疑爬虫。请切换回“规则分流 (Rule)”模式。"}},{"@type":"Question","name":"什么是 no-resolve 参数？为什么建议所有 IP 规则都加上它？","acceptedAnswer":{"@type":"Answer","text":"默认情况下，当请求一个纯域名时，如果匹配到了 IP 规则，客户端必须先在本地解析出真实 IP 才能比对。这会导致未翻墙的 DNS 遭遇污染且消耗查询时间。加上 `no-resolve` 后，内核跳过本地解析，仅在流量直接是 IP 时才比对，大幅提升命中速度。"}},{"@type":"Question","name":"如何给特定的软件（如特定的海外游戏）单独指定走某个代理节点？","acceptedAnswer":{"@type":"Answer","text":"在支持进程匹配的客户端（如 Clash Verge Rev 开启 TUN 模式）中，可以使用 `PROCESS-NAME,game.exe,游戏策略组` 规则，将该进程的所有 TCP/UDP 流量强行指定至特定低延迟节点。"}},{"@type":"Question","name":"国内规则库经常更新，我需要手动每次重新下载吗？","acceptedAnswer":{"@type":"Answer","text":"不需要。只要在配置文件中使用 `rule-providers` 声明外部规则，并设置 `interval: 86400`，客户端会在后台每 24 小时自动静默拉取更新最新的域名库，完全无需人工干预。"}},{"@type":"Question","name":"光速云的订阅自带哪些现成的分流策略组？","acceptedAnswer":{"@type":"Answer","text":"光速云的专属订阅已预设了：国外媒体、国内媒体、AI 办公、学术科研、漏网之鱼 等多维智能分流组，开箱即用，无需用户编写任何一行代码即可享受丝滑的自动分流。"}}]}]};

const guangsu = brands.find(b => b.id === 'guangsu') || brands[0];
const displayBrands = brands.slice(0, 6);
const faqs = [{"q":"为什么访问国内网站（如百度、淘宝）突然变慢或验证码频出？","a":"这 99% 是因为客户端误开成了“全局代理 (Global)”模式，导致所有本应直连的国内流量绕道海外机房再折返，延迟飙升且国内电商平台会将海外 IP 标记为可疑爬虫。请切换回“规则分流 (Rule)”模式。"},{"q":"什么是 no-resolve 参数？为什么建议所有 IP 规则都加上它？","a":"默认情况下，当请求一个纯域名时，如果匹配到了 IP 规则，客户端必须先在本地解析出真实 IP 才能比对。这会导致未翻墙的 DNS 遭遇污染且消耗查询时间。加上 `no-resolve` 后，内核跳过本地解析，仅在流量直接是 IP 时才比对，大幅提升命中速度。"},{"q":"如何给特定的软件（如特定的海外游戏）单独指定走某个代理节点？","a":"在支持进程匹配的客户端（如 Clash Verge Rev 开启 TUN 模式）中，可以使用 `PROCESS-NAME,game.exe,游戏策略组` 规则，将该进程的所有 TCP/UDP 流量强行指定至特定低延迟节点。"},{"q":"国内规则库经常更新，我需要手动每次重新下载吗？","a":"不需要。只要在配置文件中使用 `rule-providers` 声明外部规则，并设置 `interval: 86400`，客户端会在后台每 24 小时自动静默拉取更新最新的域名库，完全无需人工干预。"},{"q":"光速云的订阅自带哪些现成的分流策略组？","a":"光速云的专属订阅已预设了：国外媒体、国内媒体、AI 办公、学术科研、漏网之鱼 等多维智能分流组，开箱即用，无需用户编写任何一行代码即可享受丝滑的自动分流。"}];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Top Hub Header -->
    <header class="mb-8 border-b border-slate-200 pb-6">
      <div class="flex items-center gap-2 text-xs font-semibold text-blue-600 mb-2">
        <span>智能无感分流 · 国内外互不干扰</span>
        <span>·</span>
        <span>上级主题: <a href="/tutorials/" class="underline hover:text-blue-800">使用教程总览</a></span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        分流规则设置指南：国内直连与海外代理智能分流实战
      </h1>
      <p class="text-slate-600 text-sm sm:text-base mt-3 leading-relaxed max-w-4xl">
        好的科学上网体验应当是“润物细无声”的——国内服务走极速千兆直连，海外受限服务自动走专线代理。本文带您搭建丝滑的分流规则体系。
      </p>
    </header>

    <!-- Main Two-Column Grid on Desktop -->
    <div class="lg:grid lg:grid-cols-12 lg:gap-8 items-start">
      
      <!-- Left Column: Main Long-Form Encyclopedic Content -->
      <div class="lg:col-span-9 min-w-0">
        
        <!-- Answer-First Executive Summary Box -->
        <section id="verdict" class="scroll-mt-24 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl border border-blue-200 p-6 sm:p-8 mb-12 shadow-sm">
          <div class="flex items-center gap-2 text-blue-950 font-extrabold text-lg mb-3">
            <span class="text-xl">💡</span>
            <span>分流核心哲学 (Verdict)</span>
          </div>
          <div class="text-sm sm:text-base text-blue-950 leading-relaxed space-y-3 font-sans">
            <p><strong>科学上网严禁全天候开启“全局代理（Global）”模式</strong>！正确的姿势是开启<strong>“规则分流（Rule）”</strong>，通过精确配置国内域名与 GeoIP 白名单，让国内的微信、钉钉、网银及视频直连本地宽带，海外的 Google、ChatGPT、YouTube 自动走专线代理，做到速度拉满、内外互不干扰。</p>
          </div>
        </section>

        <!-- Section 1: Deep Industry / Technical Analysis -->
        <section id="section-1" class="scroll-mt-24 mb-14">
          <h2 class="text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span class="w-1.5 h-6 bg-blue-600 rounded-full inline-block"></span>
            一、 规则引擎匹配哲学：短路求值与优先级黄金阶梯
          </h2>
          <div class="text-slate-700 text-sm sm:text-base leading-relaxed space-y-4">
            <p>要想构建一套条理清晰且高效的分流规则系统，必须牢记代理内核的核心匹配机制：<strong>“自上而下匹配，一旦命中立即短路退出（Short-Circuit Evaluation）”</strong>。如果一条过于宽泛的规则被摆在最上方，排在它后面的所有精细化规则都将彻底失效。</p>
<div class="p-5 bg-slate-900 text-slate-200 rounded-2xl font-mono text-xs my-4 space-y-2 border border-slate-800">
  <div class="text-emerald-400 font-bold mb-2">【分流规则执行优先级自顶向下阶梯】</div>
  <div>1. [最高优先级] 本地与局域网直连 (IP-CIDR, 192.168.0.0/16, DIRECT, no-resolve)</div>
  <div>2. [专用业务精准分流] AI 服务与流媒体 (RULE-SET, openai, OpenAI策略组)</div>
  <div>3. [广告与恶意域名阻断] 广告过滤 (RULE-SET, reject, REJECT)</div>
  <div>4. [国内域名白名单] 国内主流网站直连 (GEOSITE, cn, DIRECT)</div>
  <div>5. [国内 IP 地址库白名单] 国内 IP 直连 (GEOIP, CN, DIRECT, no-resolve)</div>
  <div>6. [最低优先级/兜底] 未匹配流量走海外代理或直连 (MATCH, PROXY 或 DIRECT)</div>
</div>
<p>特别需要强调 <code>no-resolve</code> 参数的极端重要性。在匹配 <code>IP-CIDR</code> 或 <code>GEOIP</code> 规则时加上 <code>no-resolve</code>，可以强制代理内核不对纯域名流量发起反向本地 DNS 解析，<strong>既大幅削减了 DNS 解析带来的延迟开销，又彻底杜绝了 DNS 污染与真实 IP 泄漏</strong>。</p>
          </div>
        </section>

        <!-- Section 2: Core Architecture & Traps -->
        <section id="section-2" class="scroll-mt-24 mb-14">
          <h2 class="text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span class="w-1.5 h-6 bg-indigo-600 rounded-full inline-block"></span>
            二、 告别微信慢与网银风控：高精度防漏分流方案构建
          </h2>
          <div class="text-slate-700 text-sm sm:text-base leading-relaxed space-y-4">
            <p>许多用户经常遇到开启代理后“微信发图片缓慢”、“支付宝提示异地登录”或“国内打车软件定位飘到海外”的问题。这完全是由于分流规则覆盖不全、导致国内流量被误送至境外节点引起的：</p>
<ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm text-slate-700 my-3">
  <li><strong>精准放行国内通信巨头：</strong> 确保规则集中包含 <code>DOMAIN-SUFFIX,qq.com,DIRECT</code> 与 <code>DOMAIN-SUFFIX,wechat.com,DIRECT</code> 等规则，避免微信走代理导致聊天图片收发卡顿或异地多因子验证；</li>
  <li><strong>金融网银与证券直连保护：</strong> 银行 App（招行、工行等）与证券交易终端对访问 IP 变动极其敏感。通过引入专门的 <code>direct.list</code> 规则集，将所有银联、央行清算中心及各大银行域名强制绑定为 <code>DIRECT</code>；</li>
  <li><strong>解决 Steam / 战网游戏平台国区下载：</strong> 游戏平台的 CDN 服务器在国内拥有充沛的机房缓存。通过将 <code>steamcontent.com</code> 与 <code>battlenet.com.cn</code> 指定为直连，可以跑满本地千兆宽带下载，同时仅将商城与社区浏览流量分流至香港节点；</li>
  <li><strong>定期更新本地 GeoIP 数据库：</strong> 随着国内三大运营商新号段与云厂商 IP 的持续下发，必须定期让客户端更新本地的 <code>GeoIP.dat</code> 与 <code>GeoSite.dat</code> 数据库，防止新分配的国内 IP 被误当成海外地址。</li>
</ul>
          </div>
        </section>

        <!-- Section 3: Head-to-Head Specification / Comparison Table -->
        <section id="comparison-table" class="scroll-mt-24 mb-14">
          <h2 class="text-2xl font-bold text-slate-900 mb-2 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span class="w-1.5 h-6 bg-emerald-600 rounded-full inline-block"></span>
            常用分流规则语法特性与执行开销对照表
          </h2>
      <p class="text-xs sm:text-sm text-slate-600 mb-4">
        内核规则执行效率与语法特性对比：
      </p>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm mb-6">
        <table class="w-full text-xs sm:text-sm text-left border-collapse">
          <thead class="bg-slate-100 text-slate-800 font-bold border-b border-slate-200">
            <tr>
              <th class="py-3 px-4">规则类型</th><th class="py-3 px-4">语法示例</th><th class="py-3 px-4">匹配原理</th><th class="py-3 px-4">DNS 依赖性</th><th class="py-3 px-4">性能开销</th><th class="py-3 px-4">适用场景</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">DOMAIN-SUFFIX</td><td class="py-3 px-4 ">DOMAIN-SUFFIX,google.com,Proxy</td><td class="py-3 px-4 ">域名后缀树查找</td><td class="py-3 px-4 ">无依赖 (直接比对字符串)</td><td class="py-3 px-4 ">极低 (首选)</td><td class="py-3 px-4 ">精准匹配海外大型服务</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">GEOSITE</td><td class="py-3 px-4 ">GEOSITE,cn,DIRECT</td><td class="py-3 px-4 ">高效预编译域名集</td><td class="py-3 px-4 ">无依赖 (纯域名比对)</td><td class="py-3 px-4 ">极低</td><td class="py-3 px-4 ">大规模国内域名白名单</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">GEOIP</td><td class="py-3 px-4 ">GEOIP,CN,DIRECT,no-resolve</td><td class="py-3 px-4 ">二叉树 IP 范围比对</td><td class="py-3 px-4 ">加 no-resolve 零依赖</td><td class="py-3 px-4 ">低</td><td class="py-3 px-4 ">数百万国内公网 IP 兜底</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">DOMAIN-KEYWORD</td><td class="py-3 px-4 ">DOMAIN-KEYWORD,openai,AI</td><td class="py-3 px-4 ">全局字符串模糊搜索</td><td class="py-3 px-4 ">无依赖</td><td class="py-3 px-4 ">中等</td><td class="py-3 px-4 ">覆盖特定品牌的长尾子域名</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">IP-CIDR</td><td class="py-3 px-4 ">IP-CIDR,192.168.0.0/16,DIRECT</td><td class="py-3 px-4 ">CIDR 子网掩码匹配</td><td class="py-3 px-4 ">需注意反向解析</td><td class="py-3 px-4 ">低</td><td class="py-3 px-4 ">局域网、内网穿透直连</td>
              </tr>
            
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 4: Brand Showcase Grid -->
    <section id="recommended-brands" class="scroll-mt-24 mb-14">
      <h2 class="text-2xl font-bold text-slate-900 mb-6 pb-2 border-b border-slate-100">
        分流预设完善、原生支持主流规则集的专线服务商
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {displayBrands.map(b => (
          <BrandCard brand={b} />
        ))}
      </div>
    </section>

    <!-- Section 5: Buyer Decision Tree & Best Practices -->
    <section id="decision-tree" class="scroll-mt-24 mb-14">
      <h2 class="text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-amber-500 rounded-full inline-block"></span>
        分流场景选型决策树
      </h2>
      <div class="text-slate-700 text-sm sm:text-base leading-relaxed space-y-4">
        <div class="bg-amber-50/70 border border-amber-200 rounded-2xl p-5 space-y-3 my-4">
          
            <div class="flex items-start gap-3">
              <span class="font-bold text-amber-900 bg-amber-200/80 px-2 py-0.5 rounded text-xs flex-shrink-0">重度国内办公</span>
              <p class="text-xs sm:text-sm text-slate-800 leading-relaxed">
                <strong>日常大量使用钉钉、腾讯会议与内网 OA：</strong> 严格配置 GEOSITE,cn 与 GEOIP,CN 优先走 DIRECT 直连，保证视频会议画质不降级、局域网打印机随时可用。
              </p>
            </div>
          
            <div class="flex items-start gap-3">
              <span class="font-bold text-amber-900 bg-amber-200/80 px-2 py-0.5 rounded text-xs flex-shrink-0">科研与学术检索</span>
              <p class="text-xs sm:text-sm text-slate-800 leading-relaxed">
                <strong>需要访问 Google Scholar 与各类英文学术论文：</strong> 将 IEEE、Nature、arXiv 等学术域名加入代理组，并绑定香港或日本原生节点，避免论文检索频繁遭遇验证码。
              </p>
            </div>
          
            <div class="flex items-start gap-3">
              <span class="font-bold text-amber-900 bg-amber-200/80 px-2 py-0.5 rounded text-xs flex-shrink-0">跨境电商运营</span>
              <p class="text-xs sm:text-sm text-slate-800 leading-relaxed">
                <strong>管理亚马逊店铺、Shopee 卖家后台：</strong> 必须单独定制针对 Amazon 域名的固定节点策略，严禁加入 url-test 避免 IP 漂移导致店铺关联封禁。
              </p>
            </div>
          
        </div>

        <h3 class="text-lg font-bold text-slate-900 mt-6 mb-2">分流规则编写五大守则：</h3>
        <ol class="list-decimal pl-5 space-y-2 text-xs sm:text-sm text-slate-700">
          <li>永远将局域网网段（如 10.0.0.0/8、192.168.0.0/16）的 DIRECT 规则放在最顶端，防止局域网设备互访受阻；</li><li>针对国内域名与 IP，务必附带 <code>no-resolve</code> 标志，杜绝不必要的本地 DNS 解析延迟；</li><li>切勿把最终的 <code>MATCH</code> 兜底规则随意设为 PROXY，必须设为受控策略组或 DIRECT；</li><li>尽量使用成熟维护的开源规则集（Rule-Providers），避免自己在本地手动维护数十万条琐碎规则；</li><li>定期在浏览器中打开 <code>ipinfo.io</code> 与 <code>cip.cc</code>，分别测试海外与国内出站 IP，验证分流准确性。</li>
        </ol>
      </div>
    </section>

    <!-- Section 6: In-Depth FAQ Accordion -->
    <section id="faqs" class="scroll-mt-24 mb-14">
      <h2 class="text-2xl font-bold text-slate-900 mb-6 pb-2 border-b border-slate-100">
        分流规则高频技术疑问解答 (FAQ)
      </h2>
      <div class="space-y-4">
        {faqs.map((f, i) => (
          <details class="group bg-white rounded-2xl border border-slate-200 p-5 open:ring-2 open:ring-blue-500/20 transition shadow-sm">
            <summary class="font-bold text-slate-900 text-sm sm:text-base cursor-pointer flex items-center justify-between list-none">
