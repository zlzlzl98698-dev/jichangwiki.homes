              <th class="py-3 px-4">移动操作系统</th><th class="py-3 px-4">主力推荐软件</th><th class="py-3 px-4">内核引擎架构</th><th class="py-3 px-4">后台保活机制</th><th class="py-3 px-4">息屏每小时耗电</th><th class="py-3 px-4">网络切换自愈能力</th><th class="py-3 px-4">推荐评级</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">iOS / iPadOS</td><td class="py-3 px-4 ">Shadowrocket (小火箭)</td><td class="py-3 px-4 ">自研轻量级 C 引擎</td><td class="py-3 px-4 ">系统级 NetworkExtension (极佳)</td><td class="py-3 px-4 ">< 0.5% (极度省电)</td><td class="py-3 px-4 ">秒级无感自愈</td><td class="py-3 px-4 ">★★★★★ (苹果首选)</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">iOS / iPadOS</td><td class="py-3 px-4 ">Quantumult X / Loon</td><td class="py-3 px-4 ">高级分流引擎</td><td class="py-3 px-4 ">NE 框架 + 本地脚本</td><td class="py-3 px-4 ">约 0.8% ~ 1.2%</td><td class="py-3 px-4 ">极佳</td><td class="py-3 px-4 ">★★★★☆ (进阶极客)</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">Android</td><td class="py-3 px-4 ">v2rayNG</td><td class="py-3 px-4 ">Xray-core 原生</td><td class="py-3 px-4 ">前台前置常驻服务通知栏</td><td class="py-3 px-4 ">约 1.0% ~ 1.5%</td><td class="py-3 px-4 ">良好</td><td class="py-3 px-4 ">★★★★★ (安卓首选)</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">Android</td><td class="py-3 px-4 ">FlClash</td><td class="py-3 px-4 ">Mihomo (Go 跨平台)</td><td class="py-3 px-4 ">前台常驻服务</td><td class="py-3 px-4 ">约 1.2% ~ 2.0%</td><td class="py-3 px-4 ">良好</td><td class="py-3 px-4 ">★★★★☆ (现代UI)</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">HarmonyOS</td><td class="py-3 px-4 ">v2rayNG</td><td class="py-3 px-4 ">Xray-core</td><td class="py-3 px-4 ">需手动加入电池白名单</td><td class="py-3 px-4 ">约 1.5%</td><td class="py-3 px-4 ">中等</td><td class="py-3 px-4 ">★★★★☆ (鸿蒙适配)</td>
              </tr>
            
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 4: Brand Showcase Grid -->
