            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">v2rayNG</td><td class="py-3 px-4 ">Xray-core / V2Ray</td><td class="py-3 px-4 ">良好 (支持GeoIP/Domain)</td><td class="py-3 px-4 ">极低 (约 30MB)</td><td class="py-3 px-4 ">极高 (老牌稳定抗造)</td><td class="py-3 px-4 ">简朴实用</td><td class="py-3 px-4 ">★★★★★ (首选力荐)</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">FlClash</td><td class="py-3 px-4 ">Mihomo (Clash.Meta)</td><td class="py-3 px-4 ">极佳 (完整策略组支持)</td><td class="py-3 px-4 ">中等 (约 80MB)</td><td class="py-3 px-4 ">良好 (前台保活)</td><td class="py-3 px-4 ">极其现代美观</td><td class="py-3 px-4 ">★★★★★ (颜值首选)</td>
              </tr>
            
              <tr class="hover:bg-blue-50/50 transition">
                <td class="py-3 px-4 font-bold text-slate-900">Clash Meta for Android</td><td class="py-3 px-4 ">Mihomo</td><td class="py-3 px-4 ">极佳</td><td class="py-3 px-4 ">中等 (约 70MB)</td><td class="py-3 px-4 ">良好</td><td class="py-3 px-4 ">经典成熟</td><td class="py-3 px-4 ">★★★★☆</td>
              </tr>
            
