            <a href="#related-articles" class="block py-1.5 px-2.5 rounded-lg hover:bg-blue-50 hover:text-blue-600 transition truncate">七、 关联三级长文</a>
          </nav>
        </div>

        <!-- Quick Sponsor Mini-Card -->
